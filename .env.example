# ── Backend ──────────────────────────────────────────────────────────
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h
DB_FILE=./server/data.json

# Seed credentials (auto-created if the store has no users)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# MQTT bridge — subscribes to device telemetry and publishes relay/commands.
# Uses HiveMQ Cloud's secure WebSocket listener (8884).
MQTT_ENABLED=1
MQTT_HOST=
MQTT_PORT=8884
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PREFIX=esp32/relay
# Optional: override the full URL, e.g. wss://host:8884/mqtt
# MQTT_URL=

# ── Frontend (Vite dev) ─────────────────────────────────────────────
# Address of the ESP32 on your network (kept for the legacy local view).
VITE_DEVICE=192.168.4.1
